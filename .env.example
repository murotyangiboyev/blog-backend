# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_DB=blogdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# --- RabbitMQ ---
RABBITMQ_USERNAME=blog
RABBITMQ_PASSWORD=change-me-strong-password

# --- Blog admin account (created on first startup) ---
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=change-me-strong-password

# --- Blog owner details ---
BLOG_OWNER_NAME=Murat
BLOG_OWNER_TITLE=Software Developer

# --- Host port the app is published on ---
APP_PORT=8080
